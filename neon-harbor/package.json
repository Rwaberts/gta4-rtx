{
	"name": "neon-harbor",
	"version": "0.1.0",
	"private": true,
	"description": "Neon Harbor - an original open-world action game prototype (Three.js + TypeScript)",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"smoke": "node tests/smoke/smoke.mjs"
	},
	"dependencies": {
		"three": "^0.186.1"
	},
	"devDependencies": {
		"@types/three": "^0.186.0",
		"playwright": "1.56.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.6",
		"vitest": "^3.2.7"
	}
}
